# ============================================================
# Project ECLIPSE — .gitignore
# repo root = CollectRPG (Unity 프로젝트만 공개, 문서·하네스·전략 비공개)
# ============================================================

# ---- 비공개: 작업 하네스 · 커리어 전략 · 작업 파일 ----
CLAUDE.md
.claude/
_workspace/
.serena/
.mcp.json

# ---- 비공개: 기획·설계·화면정의 문서 전체 (로컬 원본만 유지, 푸시 금지) ----
Docs/

# ---- 콘텐츠(아트·오디오) 비커밋 규칙은 파일 하단 "콘텐츠 비커밋" 섹션 참조 ----
# (ExternalArt 구분 폐지 — 모든 아트는 Assets/Eclipse/Art/ 로 통합, 폴더째 제외)

# ---- Unity 표준 (프로젝트가 하위 폴더에 생겨도 매칭되도록 비고정 패턴) ----
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]serSettings/
[Mm]emoryCaptures/
[Rr]ecordings/
.gradle/

# 안전장치: 에셋 meta는 대응 에셋이 무시될 때만 무시 (공식 Unity.gitignore)
# ↑ ExternalArt 블록이 파일은 빼고 .meta는 유지하는 규칙과 함께 동작
!/[Aa]ssets/**/*.meta

# Addressables 빌드 산출물 (W11 — 설정은 커밋, 빌드 결과만 제외)
ServerData/
[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# 크래시 리포트 · 패키지 캐시
[Cc]rashlytics-build.properties
[Aa]ssets/[Pp]lugins/[Ee]ditor/JetBrains*
[Aa]ssets/[Ss]treamingAssets/aa.meta
[Aa]ssets/[Ss]treamingAssets/aa/*

# ---- IDE · OS ----
.vs/
.idea/
.vscode/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
